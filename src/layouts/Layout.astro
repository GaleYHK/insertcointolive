---
// src/layouts/Layouts.astro
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
	title?: string;
}
const { title = "InsertCoinToLive" } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Page Title -->
		<title>{title}</title>

		<!-- Font Stack Preconnect -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

		<!-- Fonts : Space Grotesk & Jetbrain Mono -->
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- 1. Top Header -->
		 <Header />	
		 <!-- 2. Sidebar -->
		  <div class="cabinet-grid">
			<!-- Left Sidebar -->
			 <Sidebar />

			 <main class="center-viewpoint">
				<slot />
			 </main>
		  </div>
	</body>
</html>

<style is:global>
	:root {
		--bg-void: #0a0b10;
		--bg-panel: #141721;
		--accent-gold: #ffd000;
		--accent-cyan: #05d9e8;
		--accent-pink: #ff2a6d;
		--font-display: 'JetBrains Mono' , monospace;
		--font-body: 'Space Grotesk' , sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background-color: var(--bg-void);
		color: #e6e6e6;
		font-family: var(--font-body);
	}

	.cabinet-grid{
		display: grid;
		grid-template-columns: 240px 1fr;
		min-height: calc(100vh - 49px);
	}

	.content-viewport{
		padding: 2rem;
		overflow-y: auto;
	}

	@media 	(max-width: 768px) {
		.cabinet-grid{
			grid-template-columns: 1fr;
		}
	}
</style>
