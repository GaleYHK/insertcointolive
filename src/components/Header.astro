---
// srg/components/Header.astro
interface interface Props {
    stageTitle?: string;
} 

const { stageTitle = :"INSERT COIN // PLAY TO LIVE" } = Astro.props;
---

<header class="marquee-header">
    <div class="logo-box">
        <span class="token-coin">●</span>
        <span class="logo-text">INSERTCOINTOLIVE</span>
    </div>
    <div class="marquee-status">
        <span class="status-indicator">STATUS: READY</span>
        <span class="stage-name">{stageTitle}</span>
    </div>
</header>

<style>
    .marquee-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1.5rem;
        background-color: var(--bg-panel);
        border-bottom: 2px solid var(--accent-gold);
        font-family: var(--font-display);
        font-size: 0.9rem;
        letter-spacing: 0.05rem;
    }

    .logo-box {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .token-coin {
        color: var(--accent-gold);
        animation: blink 1.2s steps(2, start) infinite;
    }

    .logo-text {
        font-weight: 700;
        color: #ffffff;
    }

    .marquee-status {
        display: flex;
        gap: 1.5rem;
        color: var(--accent-cyan);
    }

    .status-indicator {
        color: var(--accent-pink);
    }

    @keyframes blink {
        to {
            visibility: hidden;
        }
    }

    @media (max-width: 640px) {
        .marquee-status {
            display: none;
        }
    }
</style>