---
import Layout from '../layouts/Layout.astro';
---

<Layout title="INSERT COIN // PLAY TO LIVE">
	<section class = "title-screen">
		<div class="title-cluster">
			<p class="stage-tag">[ WELCOME TO THE ARCHIVE ]</p>
			<h1 class="arcade-tag">INSERT COIN<br />TO LIVE</h1>
		</div>
		<div class="prompt-pivot">
			<p class="coin-prompt">PRESS START // 1 PLAYER ONLY</p>
			<a href="/about" class="start-button">
				<span class="btn-cursor">></span>
				<span class="'btn-text">GAME START</span>
			</a>
		</div>
	</section>
</Layout>

<style>
	.title-screen {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		min-height: 75vh;
		text-align: center;
		padding: 2rem 1rem;
		overflow: hidden;
	}
	.title-cluster {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		animation: arcadeRise 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	.arcade-title {
		
	}
</style>